<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navisense_black"
    android:padding="24dp">

    <!-- App Title (Single H1 equivalent) -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/navisense_white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- System Status Indicator Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/navisense_card_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/navisense_yellow"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSystemMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textColor="@color/navisense_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPathStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/status_path_unknown"
                android:textColor="@color/status_unknown"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSensorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_sensor_unavailable"
                android:textColor="@color/navisense_white"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Start Walking Action (Primary Navigation Button) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartWalking"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/btn_start_bg"
        android:text="@string/btn_start_walking"
        android:textColor="@color/btn_start_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:contentDescription="@string/btn_start_walking_desc"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search Nearby Action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSearchNearby"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/navisense_yellow"
        android:text="@string/btn_search_nearby"
        android:textColor="@color/navisense_black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:contentDescription="@string/btn_search_nearby_desc"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnStartWalking"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Confirm Arrival Action (Visible during Target Navigation) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmArrival"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/navisense_white"
        android:text="@string/btn_arrival"
        android:textColor="@color/navisense_black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:contentDescription="@string/btn_arrival_desc"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnSearchNearby"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STOP Button (Critical Accessible Safety Control - Fixed at bottom) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:backgroundTint="@color/btn_stop_bg"
        android:text="@string/btn_stop"
        android:textColor="@color/btn_stop_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:contentDescription="@string/btn_stop_desc"
        app:cornerRadius="20dp"
        app:strokeColor="@color/navisense_white"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
